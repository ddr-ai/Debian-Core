#!/bin/bash
# DainRaku OS Hook: Set Ghostty as default terminal and BrowserOS as default browser
#
# Ghostty and BrowserOS are not packaged in Debian/Kali apt, and Ghostty has no
# official Flathub app ID, so their installation is BEST-EFFORT. This hook must
# never abort the build if an optional app is unavailable — it installs what it
# can and only wires up defaults for binaries that actually ended up present.
set -uo pipefail

echo "[DainRaku] Configuring Ghostty and BrowserOS as system defaults..."

# ── Ghostty Terminal (best-effort) ───────────────────────────────────────────
if ! command -v ghostty &>/dev/null; then
    echo "[DainRaku] Attempting to install Ghostty terminal from APT..."
    apt-get install -y ghostty 2>/dev/null \
        || echo "[DainRaku] Ghostty not available in APT — skipping (users can install it post-install)."
fi

# Only set Ghostty as the default terminal if it was actually installed.
if command -v ghostty &>/dev/null; then
    update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator /usr/bin/ghostty 100 || true
    update-alternatives --set x-terminal-emulator /usr/bin/ghostty || true

    mkdir -p /etc/skel/.config
    cat > /etc/skel/.config/kdeglobals << 'EOF'
[General]
TerminalApplication=ghostty
TerminalService=com.mitchellh.ghostty
EOF

    # Ghostty config with dark theme and nerd font
    mkdir -p /etc/skel/.config/ghostty
    cat > /etc/skel/.config/ghostty/config << 'EOF'
# DainRaku OS — Ghostty Configuration
font-family = "JetBrains Mono"
font-size = 13
theme = "dark"
background-opacity = 0.95
background-blur-radius = 20
cursor-style = block
cursor-style-blink = true
scrollback-limit = 10000
copy-on-select = true
window-decoration = false
EOF
fi

# ── BrowserOS (best-effort) ──────────────────────────────────────────────────
if ! command -v browseros &>/dev/null; then
    echo "[DainRaku] Attempting to install BrowserOS..."
    apt-get install -y browseros 2>/dev/null || {
        if curl -fsSL https://browseros.dev/linux/signing-key.gpg | gpg --dearmor -o /usr/share/keyrings/browseros-keyring.gpg 2>/dev/null; then
            echo "deb [signed-by=/usr/share/keyrings/browseros-keyring.gpg] https://apt.browseros.dev stable main" \
                > /etc/apt/sources.list.d/browseros.list
            apt-get update -y 2>/dev/null || true
            apt-get install -y browseros 2>/dev/null \
                || echo "[DainRaku] BrowserOS repo install failed — skipping."
        else
            echo "[DainRaku] BrowserOS signing key unavailable — skipping."
        fi
    }
fi

# Only set BrowserOS as the default browser if it was actually installed.
if command -v browseros &>/dev/null; then
    xdg-settings set default-web-browser browseros.desktop 2>/dev/null || true
    update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/bin/browseros 200 || true
    update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser /usr/bin/browseros 200 || true

    mkdir -p /etc/skel/.config
    cat >> /etc/skel/.config/kdeglobals << 'EOF'
[General]
BrowserApplication=browseros.desktop
EOF
fi

echo "[DainRaku] Ghostty and BrowserOS configuration complete (best-effort)."
