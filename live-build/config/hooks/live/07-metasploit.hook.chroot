#!/bin/bash
# DainRaku OS Hook: Initialize Metasploit Framework database
set -euo pipefail

echo "[DainRaku] Initializing Metasploit Framework..."

# Ensure PostgreSQL is running
systemctl start postgresql || service postgresql start

# Create msfdb user and database
sudo -u postgres psql -c "CREATE USER msf WITH PASSWORD 'msf';" 2>/dev/null || true
sudo -u postgres psql -c "CREATE DATABASE msf OWNER msf;" 2>/dev/null || true
sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE msf TO msf;" 2>/dev/null || true

# Write Metasploit database config
mkdir -p /root/.msf4 /home/pentester/.msf4
cat > /root/.msf4/database.yml << 'EOF'
development:
  adapter: postgresql
  database: msf
  username: msf
  password: msf
  host: 127.0.0.1
  port: 5432
  pool: 5
  timeout: 5
EOF
cp /root/.msf4/database.yml /home/pentester/.msf4/database.yml
chown -R pentester:pentester /home/pentester/.msf4

# Wireshark: enable non-root packet capture
groupadd -f wireshark
chgrp wireshark /usr/bin/dumpcap
chmod 750 /usr/bin/dumpcap
setcap cap_net_raw,cap_net_admin=eip /usr/bin/dumpcap

echo "[DainRaku] Metasploit and Wireshark configured."
