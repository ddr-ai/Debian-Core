# DainRaku OS — Calamares Branding Descriptor
# Controls the installer's visual identity: logo, colors, welcome text, slideshow.

componentName: dainraku

# ── Product identity ──────────────────────────────────────────────────────────
strings:
    productName:         "DainRaku OS"
    shortProductName:    "DainRaku"
    version:             "1.0"
    shortVersion:        "1.0"
    versionedName:       "DainRaku OS 1.0"
    shortVersionedName:  "DainRaku 1.0"
    bootloaderEntryName: "DainRaku OS"
    productUrl:          "https://github.com/dainraku-os/dainraku"
    supportUrl:          "https://github.com/dainraku-os/dainraku/issues"
    knownIssuesUrl:      "https://github.com/dainraku-os/dainraku/issues"
    releaseNotesUrl:     "https://github.com/dainraku-os/dainraku/releases"

# ── Images ────────────────────────────────────────────────────────────────────
images:
    productLogo:         "dainraku-logo.png"
    productIcon:         "dainraku-logo.png"
    productWelcome:      "dainraku-logo.png"

# ── Slideshow ─────────────────────────────────────────────────────────────────
slideshow:               "show.qml"
slideshowAPI:            2

# ── Sidebar / panel colors ────────────────────────────────────────────────────
# Dark cyberpunk palette: deep navy background, cyan accent
style:
    sidebarBackground:      "#0b0e14"
    sidebarText:            "#e0e8f0"
    sidebarTextSelect:      "#000000"
    sidebarBackgroundSelect: "#00f0ff"
    sidebarTextHighlight:   "#00f0ff"
