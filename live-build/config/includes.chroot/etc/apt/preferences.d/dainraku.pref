# DainRaku OS — APT Pin Preferences
# Controls package priority across all configured repositories.

# ── Debian Stable (trixie): highest default priority ─────────────────────────
Package: *
Pin: release a=trixie
Pin-Priority: 500

Package: *
Pin: release a=trixie-security
Pin-Priority: 500

Package: *
Pin: release a=trixie-updates
Pin-Priority: 500

# ── Debian Testing (forky): inert until enabled via dainraku-switch-repos ─────
Package: *
Pin: release a=testing
Pin-Priority: 1

# ── Debian Sid: inert until enabled via dainraku-switch-repos ────────────────
Package: *
Pin: release a=sid
Pin-Priority: 1

# ── Debian Experimental: always opt-in only ───────────────────────────────────
Package: *
Pin: release a=experimental
Pin-Priority: -1

# ── Kali mirror: lower than Debian stable ────────────────────────────────────
Package: *
Pin: release o=Kali
Pin-Priority: 100

# NOTE: metasploit-framework's hard dependency on oracle-instantclient-basic is
# satisfied by a local stub package in config/packages.chroot/ (the real Kali
# package needs a Kali build of libaio1t64 that conflicts with the trixie base).
# See that stub's description for details.

# ── Block all games permanently ───────────────────────────────────────────────
Package: gnome-games kde-games supertux supertuxkart openarena tuxracer
Package: extremetuxracer 0ad freeciv wesnoth nethack minetest dosbox scummvm
Package: frozen-bubble pingus bsdgames moon-buggy pacman4console ninvaders
Package: steam steam-installer lutris wine playonlinux
Pin: release *
Pin-Priority: -1
