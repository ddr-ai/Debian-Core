# DainRaku OS — APT Pin Preferences
# Controls package priority across all configured repositories.

# ── Debian Stable (trixie): highest default priority ─────────────────────────
Package: *
Pin: release a=trixie
Pin-Priority: 500

Package: *
Pin: release a=trixie-security
Pin-Priority: 500

Package: *
Pin: release a=trixie-updates
Pin-Priority: 500

# ── Debian Testing (forky): inert until enabled via dainraku-switch-repos ─────
Package: *
Pin: release a=testing
Pin-Priority: 1

# ── Debian Sid: inert until enabled via dainraku-switch-repos ────────────────
Package: *
Pin: release a=sid
Pin-Priority: 1

# ── Debian Experimental: always opt-in only ───────────────────────────────────
Package: *
Pin: release a=experimental
Pin-Priority: -1

# ── Kali mirror: lower than Debian stable ────────────────────────────────────
Package: *
Pin: release o=Kali
Pin-Priority: 100

# ── Prefer Kali's libaio1t64 so metasploit's Oracle dep resolves ─────────────
# metasploit-framework Depends oracle-instantclient-basic, which in turn Depends
# libaio1t64 (>= 0.3.113-8+kali1). trixie ships 0.3.113-8+b1 — the SAME upstream
# (0.3.113), just an older packaging revision — so the Kali build is ABI-safe to
# use everywhere and satisfies both oracle and every base package (they depend on
# libaio1t64 with >= constraints). Priority 600 (> trixie's 500) makes apt pick
# the Kali build system-wide, resolving the version conflict without dropping
# metasploit.
Package: libaio1t64
Pin: release o=Kali
Pin-Priority: 600

# ── Block all games permanently ───────────────────────────────────────────────
Package: gnome-games kde-games supertux supertuxkart openarena tuxracer
Package: extremetuxracer 0ad freeciv wesnoth nethack minetest dosbox scummvm
Package: frozen-bubble pingus bsdgames moon-buggy pacman4console ninvaders
Package: steam steam-installer lutris wine playonlinux
Pin: release *
Pin-Priority: -1
