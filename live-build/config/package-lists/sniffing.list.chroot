# DainRaku OS — Sniffing & Spoofing Package List
# Sources: Debian stable + Kali Linux APT mirror overlay

# ── Packet Capture & Analysis ─────────────────────────────────────────────────
wireshark
tshark
tcpdump
ngrep
dsniff

# ── MITM Frameworks ──────────────────────────────────────────────────────────
ettercap-common
ettercap-graphical
bettercap
mitmproxy
sslstrip
sslsplit

# ── LLMNR/mDNS/NBT Poisoning ─────────────────────────────────────────────────
responder
mitm6
# inveigh: .NET/PowerShell only — use Responder on Linux hosts

# ── DNS Spoofing ──────────────────────────────────────────────────────────────
dnschef
# fakedns: pip3 install fakedns — not in apt

# ── ARP Spoofing ──────────────────────────────────────────────────────────────
# arpspoof, macof: commands provided by the dsniff package (listed above)
arpwatch

# ── Packet Crafting & Replay ─────────────────────────────────────────────────
python3-scapy
hping3
yersinia
tcpreplay
netsed
# bittwiste: not in Debian/Kali apt; compile from https://bittwist.sourceforge.io/
# packeth: not in Debian apt; use scapy or hping3 instead
# t50: not in Debian apt; compile from https://github.com/fredericopissarra/t50

# ── SSL/TLS Interception ──────────────────────────────────────────────────────
sslsplit
# intercepter-ng: Windows/Wine tool; no Linux apt package
# hsts-preload: informational tool; no apt package

# ── Tunneling Over Covert Channels ───────────────────────────────────────────
iodine
ptunnel-ng
dns2tcp
# nstx: outdated; use iodine instead
# icmptunnel: compile from https://github.com/jamesbarlow/icmptunnel
httptunnel

# ── VPN & IKE ────────────────────────────────────────────────────────────────
ike-scan
openvpn
wireguard-tools

# ── Traffic Analysis ─────────────────────────────────────────────────────────
netsniff-ng
tcpflow
# urlsnarf, msgsnarf, mailsnarf, webspy: commands provided by dsniff package (listed above)
# tcpxtract: not in Debian/Kali apt; use tcpflow or tshark instead
# driftnet: not in Debian apt; use wireshark or tshark for media stream analysis
