# DainRaku OS — Digital Forensics & Reverse Engineering Package List
# Sources: Debian stable + Kali Linux APT mirror overlay
#
# NOTE: Tools marked [apt] are installable from Debian/Kali repos.
# Others require manual installation (noted inline).

# ── Forensics Platforms ───────────────────────────────────────────────────────
autopsy
sleuthkit

# ── Memory Forensics ─────────────────────────────────────────────────────────
volatility3
# volatility2: pip3 install volatility — not in apt
# rekall: abandoned upstream; use volatility3 instead
# lime-forensics: kernel module — compile via DKMS on target machine
# avml: Rust binary release — https://github.com/microsoft/avml/releases

# ── Disk Imaging ─────────────────────────────────────────────────────────────
dcfldd
dc3dd
guymager
ddrescue
ewf-tools
afflib-tools

# ── File Recovery & Carving ───────────────────────────────────────────────────
testdisk
# photorec: included in the testdisk package above
foremost
scalpel
extundelete
ext4magic

# ── Firmware Analysis ─────────────────────────────────────────────────────────
binwalk
# firmware-mod-kit: https://github.com/rampageX/firmware-mod-kit (compile from source)

# ── Reverse Engineering Frameworks ────────────────────────────────────────────
radare2
rizin
cutter
ghidra

# ── Debuggers ────────────────────────────────────────────────────────────────
gdb
gdb-multiarch
edb-debugger
valgrind
# pwndbg: pip3 install pwndbg — GDB plugin, not an apt package
# gef: pip3 install gef — GDB plugin, not an apt package

# ── Binary Analysis ───────────────────────────────────────────────────────────
binutils
# 'strings' is a command provided by binutils above — not a separate package
checksec
patchelf
elfutils
python3-yara
yara
# capa: https://github.com/mandiant/capa/releases (binary release, not in apt)
# floss: https://github.com/mandiant/flare-floss/releases (binary release, not in apt)

# ── Android Reverse Engineering ───────────────────────────────────────────────
apktool
jadx
# dex2jar: https://github.com/pxb1988/dex2jar (binary release, not in Debian apt)

# ── Strace / Ltrace ───────────────────────────────────────────────────────────
strace
ltrace

# ── File Identification ───────────────────────────────────────────────────────
file
xxd
hexedit
libimage-exiftool-perl
# magika: pip3 install magika — Google AI file type detection; not in Debian apt yet

# ── Malware Analysis ─────────────────────────────────────────────────────────
clamav
mat2

# ── Network Forensics ─────────────────────────────────────────────────────────
tcpdump
wireshark
tshark
# capinfos, editcap, mergecap: commands provided by the wireshark/tshark package
tcpflow
tcpreplay
ngrep
# tcpxtract: not in Debian/Kali apt repos; use tcpflow or Wireshark instead

# ── Steganography ────────────────────────────────────────────────────────────
steghide
outguess
# stegseek: https://github.com/RickdeJager/stegseek/releases (deb release, not in Debian repo)
# stegcracker: pip3 install stegcracker — not in apt
# zsteg: gem install zsteg — Ruby gem, not an apt package
