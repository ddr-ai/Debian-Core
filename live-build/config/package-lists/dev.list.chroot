# DainRaku OS — Developer & General Tools Package List
# Sources: Debian stable + Kali Linux APT mirror overlay

# ── Version Control ───────────────────────────────────────────────────────────
git
git-lfs
git-secret
git-crypt
lazygit

# ── Secret Detection ──────────────────────────────────────────────────────────
gitleaks
trufflehog

# ── Python ────────────────────────────────────────────────────────────────────
python3
python3-pip
python3-venv
python3-dev
python3-setuptools
python3-wheel
python3-requests
python3-cryptography
pipenv
python3-poetry
ipython3

# ── Ruby ──────────────────────────────────────────────────────────────────────
ruby
ruby-dev
ruby-bundler
# 'gem' is a command provided by the ruby package above — not a separate package

# ── Go ────────────────────────────────────────────────────────────────────────
golang-go

# ── Node.js / JavaScript ─────────────────────────────────────────────────────
nodejs
npm
# yarn: install via 'npm install -g yarn' after first boot; Debian package is 'yarnpkg' (older)
yarnpkg

# ── Rust ──────────────────────────────────────────────────────────────────────
rustc
cargo

# ── Java ──────────────────────────────────────────────────────────────────────
default-jdk
default-jre
maven

